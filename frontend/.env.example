# Copy to .env only when the API is NOT reached through the Vite proxy,
# for example when the built site is served from a different host.
# Leave unset for local development: requests go to /api and Vite forwards them.
# VITE_API_BASE=http://127.0.0.1:8000

# Where the dev/preview proxy forwards /api requests (default shown).
# VITE_API_PROXY=http://127.0.0.1:8000
